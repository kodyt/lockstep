{
  "expo": {
    "name": "Lockstep",
    "slug": "lockstep",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lockstep",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kt2102.lockstep",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Lockstep reads your step count to unlock the apps you choose."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true,
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.kt2102.lockstep"
        ]
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-dev-client"
    ],
    "extra": {
      "apiBase": "http://localhost:4000/v1"
    },
    "android": {
      "package": "com.kt2102.lockstep"
    }
  }
}
