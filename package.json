{
  "name": "lockstep",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:mobile": "npm --workspace apps/mobile run dev",
    "ios:mobile": "npm --workspace apps/mobile run ios",
    "postinstall": "node apps/mobile/scripts/patch-expo-modules-jsi.js"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
